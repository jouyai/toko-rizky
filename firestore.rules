rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // FUNGSI BANTUAN (HELPER FUNCTIONS)
    // =====================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =====================================================================
    // ATURAN KOLEKSI
    // =====================================================================

    // 1. Koleksi USERS (Profil Pengguna) beserta Sub-koleksinya
    match /users/{userId} {
      // Akses untuk dokumen profil user
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Akses ke sub-koleksi 'cart' (keranjang belanja)
      match /cart/{cartItemId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Koleksi PRODUCTS (Katalog Barang)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Koleksi CATEGORIES (Kategori Produk)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Koleksi ORDERS (Pesanan & Transaksi Midtrans)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Koleksi SETTINGS (Pengaturan Toko)
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // =====================================================================
    // ATURAN DEFAULT
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
